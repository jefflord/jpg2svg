# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
wheels/
*.egg
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.dmypy.json
.dmypy.json.lock
.tox/
.pytest_tmp/

# Test coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs (e.g. --log-file output)
*.log

# Environment files (if env-var config is added later)
.env
.env.*
!.env.example

# Temp files
*.tmp
*.temp
*.part
